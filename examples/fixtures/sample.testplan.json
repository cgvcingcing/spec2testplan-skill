  "schema_version": 3,
  "overview": "虚构示例：员工预约会议室，系统按身份、人数与时段占用校验提交，支持管理员确认和员工取消待确认预约，并保证重复提交不重复建单或占用。",
  "limitations": [
    "人数输入格式、已确认后的取消、同次提交识别及失败提示细节需确认。"
  ],
  "questions": [
    {
      "id": "Q-001",
      "question": "“已确认”预约是否允许取消？若允许，取消后的状态和时段占用如何变化？",
      "reason": "原文明示该行为尚未确定；影响已确认预约取消的判断，不能套用待确认预约的取消规则。",
      "requirement_ids": [
        "REQ-014"
      ],
      "evidence": [
        "SRC-001-B0009"
      ]
    },
    {
      "id": "Q-002",
      "question": "人数不符和时段被占用等失败分别显示什么文案、使用什么错误码？",
      "reason": "原文只要求展示失败原因，明确未确定文案和错误码；影响展示细节验收。",
      "requirement_ids": [
        "REQ-019",
        "REQ-018"
